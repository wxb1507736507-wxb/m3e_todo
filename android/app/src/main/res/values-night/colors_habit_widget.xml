<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-mode counterparts of `values/colors_habit_widget.xml`. Android picks this
  file automatically when the system is in dark mode, so the widget keeps
  matching the launcher and the app without the widget code asking.
-->
<resources>
    <color name="habit_widget_background">#F21C1720</color>
    <color name="habit_widget_text">#EDE6F0</color>
    <color name="habit_widget_subtle">#B9B0C0</color>
    <color name="habit_widget_accent">#CFBCFF</color>
    <color name="habit_widget_done">#8E8795</color>
</resources>
