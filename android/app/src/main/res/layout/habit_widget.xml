<?xml version="1.0" encoding="utf-8"?>
<!--
  The habit widget: one habit, 2×2 cells.

  A tile rather than a list. A list of habits on a home screen is a summary
  nobody reads at a glance, and the one thing a widget is for is the tap that
  does not need the app: a big circle in the middle of a square is that tap,
  where a row of four names with four small circles is a menu.

  Which habit this instance shows is decided per instance, in its options (see
  `HabitWidgetProvider.OPTION_HABIT_ID`), so a home screen can hold 吃药 and
  健身 side by side and each of them is one press.

  Everything the tile says comes from the app as text (`name`, `sub`); the
  layout only decides where it goes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/habit_widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/habit_widget_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The emoji takes the left half rather than a `Space` taking the
             middle: a `RemoteViews` inflates through a factory that only allows
             the classic view classes, and `Space` is not one of them — it
             throws at inflation, on the launcher's side, where nothing can be
             done about it. -->
        <TextView
            android:id="@+id/habit_widget_emoji"
            style="@style/HabitWidgetEmoji"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/habit_widget_note"
            style="@style/HabitWidgetNote"
            android:contentDescription="@string/habit_widget_note" />
    </LinearLayout>

    <!-- The one thing this widget is for. -->
    <ImageView
        android:id="@+id/habit_widget_check"
        style="@style/HabitWidgetCheck"
        android:contentDescription="@string/habit_widget_check" />

    <TextView
        android:id="@+id/habit_widget_name"
        style="@style/HabitWidgetName" />

    <TextView
        android:id="@+id/habit_widget_sub"
        style="@style/HabitWidgetSub" />

    <!-- Replaces the tile's contents when there is nothing to draw: no habits
         at all, a habit that was deleted, a day the app has not caught up
         with, or a widget that has not been pointed at a habit yet. -->
    <TextView
        android:id="@+id/habit_widget_message"
        style="@style/HabitWidgetMessage"
        android:visibility="gone" />
</LinearLayout>
