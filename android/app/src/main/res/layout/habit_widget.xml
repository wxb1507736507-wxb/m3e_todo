<?xml version="1.0" encoding="utf-8"?>
<!--
  The habit widget: today's habits stacked in a column.

  One habit per row — its circle, its emoji, its name — because a row is where a
  name and a state fit on one line, and a column of rows is what a list of
  things to do looks like. Only the circle checks a habit off; the rest of the
  row opens the arrangement screen, which is where the habits this tile shows are
  chosen and edited. That split is the whole design: the tap that changes
  something is exactly the circle, and no other tap can change anything by
  accident.

  Four rows are laid out and the unused ones are hidden: a `RemoteViews` cannot
  build a variable-length list without a collection service.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habit_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/habit_item_0"
        style="@style/HabitWidgetRow">

        <ImageView
            android:id="@+id/habit_item_0_check"
            style="@style/HabitWidgetCheck"
            android:contentDescription="@string/habit_widget_check" />

        <TextView
            android:id="@+id/habit_item_0_emoji"
            style="@style/HabitWidgetEmoji" />

        <TextView
            android:id="@+id/habit_item_0_name"
            style="@style/HabitWidgetName" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/habit_item_1"
        style="@style/HabitWidgetRow">

        <ImageView
            android:id="@+id/habit_item_1_check"
            style="@style/HabitWidgetCheck"
            android:contentDescription="@string/habit_widget_check" />

        <TextView
            android:id="@+id/habit_item_1_emoji"
            style="@style/HabitWidgetEmoji" />

        <TextView
            android:id="@+id/habit_item_1_name"
            style="@style/HabitWidgetName" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/habit_item_2"
        style="@style/HabitWidgetRow">

        <ImageView
            android:id="@+id/habit_item_2_check"
            style="@style/HabitWidgetCheck"
            android:contentDescription="@string/habit_widget_check" />

        <TextView
            android:id="@+id/habit_item_2_emoji"
            style="@style/HabitWidgetEmoji" />

        <TextView
            android:id="@+id/habit_item_2_name"
            style="@style/HabitWidgetName" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/habit_item_3"
        style="@style/HabitWidgetRow">

        <ImageView
            android:id="@+id/habit_item_3_check"
            style="@style/HabitWidgetCheck"
            android:contentDescription="@string/habit_widget_check" />

        <TextView
            android:id="@+id/habit_item_3_emoji"
            style="@style/HabitWidgetEmoji" />

        <TextView
            android:id="@+id/habit_item_3_name"
            style="@style/HabitWidgetName" />
    </LinearLayout>

    <!-- Stands in for the column when there is nothing to draw: no habits at
         all, or an app that has never synced. -->
    <TextView
        android:id="@+id/habit_widget_message"
        style="@style/HabitWidgetMessage"
        android:visibility="gone" />
</LinearLayout>
