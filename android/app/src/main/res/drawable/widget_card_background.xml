<?xml version="1.0" encoding="utf-8"?>
<!--
  What every home-screen tile is drawn on. A rounded rectangle rather than the
  launcher's own widget frame, because the frame's padding and radius differ per
  launcher and the app cannot read them.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="22dp" />
</shape>