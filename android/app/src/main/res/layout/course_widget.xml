<?xml version="1.0" encoding="utf-8"?>
<!--
  The course widget: today's classes, in the same shape as the habit tile.

  One course per row — when it starts, what it is, where it is — because that is
  the question a timetable answers at a glance: what have I got next, and where
  do I have to be. Nothing here can be *changed*, so nothing here is a button:
  tapping a row opens the timetable, which is where a course is edited.

  Four rows are laid out and the unused ones are hidden: a `RemoteViews` cannot
  build a variable-length list without a collection service.
-->
<!--
  The card is a `FrameLayout` rather than the column itself because the tile has
  three layers: the rounded surface, the user's picture over it, and a scrim of
  the surface colour over that — under the rows, which draw last. The picture is
  clipped to the card's own outline, so a chosen photo has the same corners the
  tile always had.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/course_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/course_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/course_widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Which week is on show, and how to step it. The arrows are answered by
             the widget itself, so looking at next week does not open the app. -->
        <LinearLayout
            android:id="@+id/course_widget_header"
            style="@style/CourseWidgetHeader">

            <ImageView
                android:id="@+id/course_widget_prev"
                style="@style/CourseWidgetArrow"
                android:contentDescription="@string/course_widget_prev_week"
                android:src="@drawable/widget_arrow_left" />

            <TextView
                android:id="@+id/course_widget_week"
                style="@style/CourseWidgetWeek" />

            <ImageView
                android:id="@+id/course_widget_next"
                style="@style/CourseWidgetArrow"
                android:contentDescription="@string/course_widget_next_week"
                android:src="@drawable/widget_arrow_right" />
        </LinearLayout>

    <LinearLayout
        android:id="@+id/course_item_0"
        style="@style/CourseWidgetRow">

        <TextView
            android:id="@+id/course_item_0_time"
            style="@style/CourseWidgetTime" />

        <TextView
            android:id="@+id/course_item_0_name"
            style="@style/CourseWidgetName" />

        <TextView
            android:id="@+id/course_item_0_room"
            style="@style/CourseWidgetRoom" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/course_item_1"
        style="@style/CourseWidgetRow">

        <TextView
            android:id="@+id/course_item_1_time"
            style="@style/CourseWidgetTime" />

        <TextView
            android:id="@+id/course_item_1_name"
            style="@style/CourseWidgetName" />

        <TextView
            android:id="@+id/course_item_1_room"
            style="@style/CourseWidgetRoom" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/course_item_2"
        style="@style/CourseWidgetRow">

        <TextView
            android:id="@+id/course_item_2_time"
            style="@style/CourseWidgetTime" />

        <TextView
            android:id="@+id/course_item_2_name"
            style="@style/CourseWidgetName" />

        <TextView
            android:id="@+id/course_item_2_room"
            style="@style/CourseWidgetRoom" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/course_item_3"
        style="@style/CourseWidgetRow">

        <TextView
            android:id="@+id/course_item_3_time"
            style="@style/CourseWidgetTime" />

        <TextView
            android:id="@+id/course_item_3_name"
            style="@style/CourseWidgetName" />

        <TextView
            android:id="@+id/course_item_3_room"
            style="@style/CourseWidgetRoom" />
    </LinearLayout>

    <!-- Stands in for the list when there is nothing to draw: no classes today,
         a day outside the term, or an app that has never synced. -->
    <TextView
        android:id="@+id/course_widget_message"
        style="@style/CourseWidgetMessage"
        android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
