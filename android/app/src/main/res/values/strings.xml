    <string name="habit_widget_check">打卡</string>
    <string name="habit_widget_no_data">打开应用完成一次同步</string>
    <string name="habit_widget_stale">新的一天了，打开应用刷新</string>
    <string name="habit_widget_config_title">选择这个小组件显示哪个打卡项</string>
    <string name="habit_widget_config_empty">还没有打卡项，先到应用里添加一个</string>
    <string name="habit_widget_config_cancel">取消</string>
    <!-- The overflow line: `还有 2 项`. -->
    <string name="habit_widget_more">还有 %1$d 项</string>
