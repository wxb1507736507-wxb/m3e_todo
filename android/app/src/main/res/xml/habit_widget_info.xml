<?xml version="1.0" encoding="utf-8"?>
<!--
  What the launcher needs to know before it shows the habit widget.

  `updatePeriodMillis` is half an hour — the shortest Android allows — for one
  reason only: the widget shows *today's* habits, and if the app is never opened
  again the day still changes underneath it. The periodic call is what lets the
  widget notice and stop showing yesterday's list as if it were today's. It is
  the launcher's own alarm, so it costs the app nothing to keep.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/habit_widget_description"
    android:initialLayout="@layout/habit_widget"
    android:minHeight="110dp"
    android:minWidth="180dp"
    android:previewLayout="@layout/habit_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
