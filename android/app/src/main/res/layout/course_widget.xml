<?xml version="1.0" encoding="utf-8"?>
<!--
  The course widget: one day's classes, in the same shape as the habit tile.

  One course per row — when it starts, what it is, where it is — because that is
  the question a timetable answers at a glance: what have I got next, and where
  do I have to be. Nothing here can be *changed*, so nothing here is a button:
  tapping a row opens the timetable, which is where a course is edited.

  The arrows step a DAY, and they are answered by the tile itself: the whole
  window of days it might show arrives with the payload, so looking at tomorrow
  costs one preference and one repaint rather than opening the app. The rows live
  inside a ViewFlipper with two pages so that the step *slides* — a home screen
  has no gesture to give a widget, and a change with no movement is hard to
  follow.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/course_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/course_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/course_widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/course_widget_header"
            style="@style/CourseWidgetHeader">

            <ImageView
                android:id="@+id/course_widget_prev"
                style="@style/CourseWidgetArrow"
                android:contentDescription="@string/course_widget_prev_day"
                android:src="@drawable/widget_arrow_left" />

            <TextView
                android:id="@+id/course_widget_day"
                style="@style/CourseWidgetWeek" />

            <ImageView
                android:id="@+id/course_widget_next"
                style="@style/CourseWidgetArrow"
                android:contentDescription="@string/course_widget_next_day"
                android:src="@drawable/widget_arrow_right" />
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/course_widget_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:animateFirstView="false"
            android:inAnimation="@anim/widget_day_in"
            android:outAnimation="@anim/widget_day_out">

            <!-- Page 0. Two of them, because a ViewFlipper animates between
                 pages: the day being left is one and the day arriving is the
                 other, which is what makes the switch a slide rather than a
                 swap. Only one is ever on screen. -->
            <LinearLayout
                android:id="@+id/course_page_0"
                style="@style/CourseWidgetPage">

                <LinearLayout
                    android:id="@+id/course_page0_item_0"
                    style="@style/CourseWidgetRow">

                    <TextView
                        android:id="@+id/course_page0_item_0_time"
                        style="@style/CourseWidgetTime" />

                    <TextView
                        android:id="@+id/course_page0_item_0_name"
                        style="@style/CourseWidgetName" />

                    <TextView
                        android:id="@+id/course_page0_item_0_room"
                        style="@style/CourseWidgetRoom" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/course_page0_item_1"
                    style="@style/CourseWidgetRow">

                    <TextView
                        android:id="@+id/course_page0_item_1_time"
                        style="@style/CourseWidgetTime" />

                    <TextView
                        android:id="@+id/course_page0_item_1_name"
                        style="@style/CourseWidgetName" />

                    <TextView
                        android:id="@+id/course_page0_item_1_room"
                        style="@style/CourseWidgetRoom" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/course_page0_item_2"
                    style="@style/CourseWidgetRow">

                    <TextView
                        android:id="@+id/course_page0_item_2_time"
                        style="@style/CourseWidgetTime" />

                    <TextView
                        android:id="@+id/course_page0_item_2_name"
                        style="@style/CourseWidgetName" />

                    <TextView
                        android:id="@+id/course_page0_item_2_room"
                        style="@style/CourseWidgetRoom" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/course_page0_item_3"
                    style="@style/CourseWidgetRow">

                    <TextView
                        android:id="@+id/course_page0_item_3_time"
                        style="@style/CourseWidgetTime" />

                    <TextView
                        android:id="@+id/course_page0_item_3_name"
                        style="@style/CourseWidgetName" />

                    <TextView
                        android:id="@+id/course_page0_item_3_room"
                        style="@style/CourseWidgetRoom" />
                </LinearLayout>
                <TextView
                    android:id="@+id/course_page_0_message"
                    style="@style/CourseWidgetMessage"
                    android:visibility="gone" />
            </LinearLayout>
            <!-- Page 1. Two of them, because a ViewFlipper animates between
                 pages: the day being left is one and the day arriving is the
                 other, which is what makes the switch a slide rather than a
                 swap. Only one is ever on screen. -->
            <LinearLayout
                android:id="@+id/course_page_1"
                style="@style/CourseWidgetPage">

                <LinearLayout
                    android:id="@+id/course_page1_item_0"
                    style="@style/CourseWidgetRow">

                    <TextView
                        android:id="@+id/course_page1_item_0_time"
                        style="@style/CourseWidgetTime" />

                    <TextView
                        android:id="@+id/course_page1_item_0_name"
                        style="@style/CourseWidgetName" />

                    <TextView
                        android:id="@+id/course_page1_item_0_room"
                        style="@style/CourseWidgetRoom" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/course_page1_item_1"
                    style="@style/CourseWidgetRow">

                    <TextView
                        android:id="@+id/course_page1_item_1_time"
                        style="@style/CourseWidgetTime" />

                    <TextView
                        android:id="@+id/course_page1_item_1_name"
                        style="@style/CourseWidgetName" />

                    <TextView
                        android:id="@+id/course_page1_item_1_room"
                        style="@style/CourseWidgetRoom" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/course_page1_item_2"
                    style="@style/CourseWidgetRow">

                    <TextView
                        android:id="@+id/course_page1_item_2_time"
                        style="@style/CourseWidgetTime" />

                    <TextView
                        android:id="@+id/course_page1_item_2_name"
                        style="@style/CourseWidgetName" />

                    <TextView
                        android:id="@+id/course_page1_item_2_room"
                        style="@style/CourseWidgetRoom" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/course_page1_item_3"
                    style="@style/CourseWidgetRow">

                    <TextView
                        android:id="@+id/course_page1_item_3_time"
                        style="@style/CourseWidgetTime" />

                    <TextView
                        android:id="@+id/course_page1_item_3_name"
                        style="@style/CourseWidgetName" />

                    <TextView
                        android:id="@+id/course_page1_item_3_room"
                        style="@style/CourseWidgetRoom" />
                </LinearLayout>
                <TextView
                    android:id="@+id/course_page_1_message"
                    style="@style/CourseWidgetMessage"
                    android:visibility="gone" />
            </LinearLayout>
        </ViewFlipper>
    </LinearLayout>
</FrameLayout>