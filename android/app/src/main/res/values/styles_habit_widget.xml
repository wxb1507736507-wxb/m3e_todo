<?xml version="1.0" encoding="utf-8"?>
<!--
  The sizes and colours of the habit widget's columns, and of the arrangement
  screen's rows.

  They live here rather than inline so the four identical columns cannot drift
  apart, and because the numbers are the design: a column is a circle you can hit
  with a thumb, an emoji, and one line of name, stacked and centred, four to a
  row.
-->
<resources>

    <style name="HabitWidgetConfigTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog">
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>

    <!-- One habit: a row across the tile, with the circle at its left edge where
         a thumb finds it without aiming. -->
    <style name="HabitWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- The only thing a tap can change: as large as the row allows, with the
         glyph kept small inside it so the pressable area is not the drawing. -->
    <style name="HabitWidgetCheck">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/habit_check_todo</item>
    </style>

    <style name="HabitWidgetEmoji">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="HabitWidgetName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HabitWidgetMessage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/widget_subtle</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- The course tile's rows: the same geometry as a habit row, with the time
         on the left and the room on the right, because a timetable row is read
         from its two ends inwards. -->
    <style name="CourseWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CourseWidgetTime">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_subtle</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CourseWidgetName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CourseWidgetRoom">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_subtle</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- The course tile's header: which week is on show, and the two arrows that
         step it. A home screen has no room for a gesture the launcher owns, so
         the week is stepped by tapping — and the taps are answered by the tile
         itself, without the app waking up. -->
    <style name="CourseWidgetHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CourseWidgetArrow">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/widget_subtle</item>
    </style>

    <style name="CourseWidgetWeek">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_subtle</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CourseWidgetMessage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/widget_subtle</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- The arrangement screen's rows -->

    <style name="HabitWidgetConfigRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="HabitWidgetConfigEmoji">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="HabitWidgetConfigName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
